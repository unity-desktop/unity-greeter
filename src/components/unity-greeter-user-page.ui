<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="UnityGreeterUserPage" parent="AdwNavigationPage">
    <property name="tag">login</property>
    <property name="title" translatable="yes">User Login Page</property>
    <signal name="shown"  handler="on_page_shown"  swapped="no"/>
    <signal name="hidden" handler="on_page_hidden" swapped="no"/>
    <property name="child">
      <object class="AdwBreakpointBin">
        <property name="width-request">300</property>
        <property name="height-request">400</property>
        <child>
          <object class="AdwBreakpoint">
            <condition>max-width: 500sp</condition>
            <setter object="avatar" property="size">128</setter>
          </object>
        </child>
        <property name="child">
          <object class="GtkOverlay">
            <property name="child">
              <object class="GtkPicture" id="wallpaper">
                <property name="content-fit">cover</property>
              </object>
            </property>
            <child type="overlay">
              <object class="GtkButton" id="back">
                <property name="visible">false</property>
                <property name="halign">start</property>
                <property name="valign">start</property>
                <property name="margin-top">12</property>
                <property name="margin-start">12</property>
                <property name="icon-name">go-previous-symbolic</property>
                <property name="tooltip-text" translatable="yes">Back</property>
                <property name="action-name">navigation.pop</property>
              </object>
            </child>
            <child type="overlay">
              <object class="AdwViewStack" id="stack">
                <property name="valign">center</property>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">busy</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="busy_status">
                        <property name="paintable">
                          <object class="AdwSpinnerPaintable">
                            <property name="widget">busy_status</property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">form</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="halign">fill</property>
                        <property name="valign">center</property>
                        <property name="spacing">24</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="AdwAvatar" id="avatar">
                            <property name="size">192</property>
                            <property name="show-initials">true</property>
                            <property name="halign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="name_label">
                            <property name="halign">center</property>
                            <property name="ellipsize">end</property>
                            <style>
                              <class name="title-2"/>
                              <class name="body"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="message_label">
                            <property name="visible">false</property>
                            <property name="wrap">true</property>
                            <property name="justify">center</property>
                            <property name="max-width-chars">36</property>
                            <property name="halign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwClamp">
                            <property name="maximum-size">400</property>
                            <property name="tightening-threshold">360</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="valign">center</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">24</property>
                                <child>
                                  <object class="AdwPreferencesGroup">
                                    <child>
                                      <object class="AdwPasswordEntryRow" id="entry">
                                        <property name="title" translatable="yes">Password</property>
                                        <signal name="entry-activated" handler="on_submit" swapped="no"/>
                                        <child>
                                          <object class="GtkButton" id="session_button">
                                            <property name="icon-name">emblem-system-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Session</property>
                                            <property name="valign">center</property>
                                            <signal name="clicked" handler="on_pick_session" swapped="no"/>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="caps_warning">
                                    <property name="visible">false</property>
                                    <property name="halign">center</property>
                                    <property name="label" translatable="yes">Caps Lock is on</property>
                                    <style>
                                      <class name="warning"/>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPreferencesGroup">
                                    <child>
                                      <object class="AdwButtonRow" id="submit_button">
                                        <property name="title" translatable="yes">Login</property>
                                        <signal name="activated" handler="on_submit" swapped="no"/>
                                        <style>
                                          <class name="suggested-action"/>
                                          <class name="body"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
